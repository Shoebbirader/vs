{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/api/trpc/:path*", "destination": "/api/python.py" },
    { "source": "/api/v2/:path*", "destination": "/api/python.py" },
    { "source": "/healthz", "destination": "/api/python.py" },
    { "source": "/readyz", "destination": "/api/python.py" },
    { "source": "/api/healthz", "destination": "/api/python.py" },
    { "source": "/api/readyz", "destination": "/api/python.py" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
